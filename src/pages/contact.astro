---
import Base from '../layouts/Base.astro';
import contact from '../data/pages/contact.json';
import { site } from '../data/site';
---

<Base title="Contact" description={contact.lede}>
  <header class="page-head wrap">
    <p class="eyebrow">{contact.eyebrow}</p>
    <h1>{contact.title}</h1>
    <p class="lede">{contact.lede}</p>
  </header>

  <section class="contact-hero wrap">
    <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
  </section>

  <section class="wrap">
    <div class="contact-grid">
      {contact.blocks.map((block) => (
        <div>
          <h2>{block.title}</h2>
          <p>{block.text}</p>
          <a href={`mailto:${site.email}?subject=${encodeURIComponent(block.subject)}`}>
            {block.linkLabel}
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{contact.elsewhereEyebrow}</p>
      <h2>{contact.elsewhereHeading}</h2>
      <p class="lede">{contact.elsewhereLede}</p>
      <p style="margin-top:1.6rem;display:flex;gap:1.5rem;flex-wrap:wrap">
        <a class="text-link" href={site.substack} target="_blank" rel="noopener noreferrer">
          Substack <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={site.instagram} target="_blank" rel="noopener noreferrer">
          Instagram <span aria-hidden="true">↗</span>
        </a>
      </p>
    </div>
  </section>
</Base>
