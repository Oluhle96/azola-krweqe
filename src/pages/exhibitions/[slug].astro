---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import { byOrder, type Exhibition } from '../../data/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const exhibitions = await getCollection('exhibitions');
  return exhibitions.map((exhibition) => ({
    params: { slug: exhibition.id },
    props: { exhibition },
  }));
};

const { exhibition } = Astro.props;
const { Content } = await render(exhibition);
const {
  title,
  subtitle,
  year,
  dates,
  venue,
  status,
  summary,
  cover,
  coverAlt,
  access,
  admission,
  curator,
  programme,
  artists,
  supporters,
  gallery,
} = exhibition.data;

const pageTitle = subtitle ? `${title}: ${subtitle}` : title;
const all = (await getCollection('exhibitions')).sort(byOrder) as Exhibition[];
const next = all.length > 1 ? all[(all.findIndex((item) => item.id === exhibition.id) + 1) % all.length] : undefined;
---

<Base title={pageTitle} description={summary} image={cover}>
  <article>
    <header class="exhibition-head wrap">
      <p class="eyebrow">
        <a href="/exhibitions">Exhibitions</a> — {status} / {year}
      </p>
      <h1>
        {title}
        {subtitle && <span>: <em>{subtitle}</em></span>}
      </h1>
      <p class="lede">{summary}</p>
    </header>

    <figure class="exhibition-hero wrap">
      <img
        src={cover}
        alt={coverAlt}
        width="1600"
        height="700"
        fetchpriority="high"
      />
      <figcaption>
        <span>Exhibition identity, {year}</span>
        <span>Curated by {curator}</span>
      </figcaption>
    </figure>

    <div class="wrap">
      <dl class="meta-grid">
        <div>
          <dt>Dates</dt>
          <dd>{dates}</dd>
        </div>
        <div>
          <dt>Venue</dt>
          <dd>{venue}</dd>
        </div>
        <div>
          <dt>Access</dt>
          <dd>{access}</dd>
        </div>
        <div>
          <dt>Admission</dt>
          <dd>{admission}</dd>
        </div>
      </dl>
    </div>

    <section class="section">
      <div class="wrap exhibition-grid">
        <div class="prose">
          <Content />
        </div>

        <aside class="exhibition-aside">
          {programme.length > 0 && (
            <>
              <p class="eyebrow">Programme</p>
              <ul class="programme">
                {programme.map((item) => (
                  <li>
                    <time>{item.date}</time>
                    <span>
                      {item.label}
                      {item.description && ` — ${item.description}`}
                    </span>
                  </li>
                ))}
              </ul>
            </>
          )}

          <p class="eyebrow">Supporters</p>
          {supporters.length > 0 ? (
            <ul class="programme">
              {supporters.map((item) => <li><span>{item.credit}</span></li>)}
            </ul>
          ) : (
            <p class="note">
              Funding and support credits will be published here once confirmed.
            </p>
          )}
        </aside>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Artists &amp; makers</p>
          <h2>
            {artists.length > 0
              ? 'The people behind the exhibition.'
              : 'The full list is being confirmed.'}
          </h2>
          <span class="note">Updated as approvals are received</span>
        </div>

        <ul class="artist-list">
          {artists.map((artist, index) => (
            <li>
              <span class="index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{artist.name}</h3>
              <p>{artist.role}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {gallery.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">Gallery</p>
            <h2>Installation views</h2>
          </div>

          <div class="gallery">
            {gallery.map((image) => (
              <Figure src={image.src} alt={image.alt} caption={image.caption} />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="wrap">
        <p class="eyebrow">Enquiries</p>
        <h2>For press, access and exhibition enquiries.</h2>
        <p style="margin-top:1.2rem">
          <a class="btn" href="/contact">
            Contact the studio <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </section>

    {next && (
      <div class="wrap">
        <nav class="pager" aria-label="Exhibition navigation">
          <span>Next exhibition</span>
          <a href={`/exhibitions/${next.id}`}>{next.data.title} ↗</a>
        </nav>
      </div>
    )}
  </article>
</Base>
