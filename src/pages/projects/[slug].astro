---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import { byOrder, type Project } from '../../data/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, year, role, summary, cover, coverAlt, credits, gallery, video, videoTitle } =
  project.data;

const all = (await getCollection('projects')).sort(byOrder) as Project[];
const position = all.findIndex((entry) => entry.id === project.id);
const next = all[(position + 1) % all.length];
---

<Base title={title} description={summary} image={cover}>
  <article>
    <header class="page-head wrap">
      <p class="eyebrow">
        <a href="/projects">Projects</a> — {year}
      </p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
    </header>

    <div class="wrap">
      <dl class="meta-grid">
        <div>
          <dt>Year</dt>
          <dd>{year}</dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt>Curated by</dt>
          <dd>Azola Krweqe</dd>
        </div>
        <div>
          <dt>Index</dt>
          <dd>{String(position + 1).padStart(2, '0')} / {String(all.length).padStart(2, '0')}</dd>
        </div>
      </dl>

      <figure class="project-hero">
        <img
          src={cover}
          alt={coverAlt}
          width="1600"
          height="900"
          fetchpriority="high"
        />
      </figure>

      <div class="project-body">
        <div class="prose">
          <Content />
        </div>

        {credits.length > 0 && (
          <aside class="project-credits">
            <p class="eyebrow">Credits</p>
            <ul>
              {credits.map((item) => <li>{item.credit}</li>)}
            </ul>
          </aside>
        )}
      </div>

      {video && (
        <div class="wrap">
          <VideoEmbed
            id={video}
            title={videoTitle ?? title}
            caption="Captioned excerpt. Full film available on request."
          />
        </div>
      )}

      {gallery.length > 0 && (
        <div class="gallery">
          {gallery.map((image) => (
            <Figure src={image.src} alt={image.alt} caption={image.caption} />
          ))}
        </div>
      )}

      {all.length > 1 && (
        <nav class="pager" aria-label="Project navigation">
          <span>Next project</span>
          <a href={`/projects/${next.id}`}>{next.data.title} ↗</a>
        </nav>
      )}
    </div>
  </article>
</Base>
