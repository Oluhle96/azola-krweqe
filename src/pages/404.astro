---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you are looking for could not be found.">
  <section class="notfound wrap">
    <div>
      <h1>404</h1>
      <p>That page has been moved, or never existed.</p>
      <p style="margin-top:1.6rem">
        <a class="btn" href="/">Return home <span aria-hidden="true">↗</span></a>
      </p>
    </div>
  </section>
</Base>
