---
import Base from '../layouts/Base.astro';
import about from '../data/pages/about.json';
import { site } from '../data/site';
import { getCollection } from 'astro:content';

const bioParagraphs = about.bio.split(/\n\s*\n/).filter(Boolean);

const exhibitions = await getCollection('exhibitions');
const projects = await getCollection('projects');
const work = [
  ...exhibitions.map((exhibition) => ({
    year: exhibition.data.year,
    title: exhibition.data.subtitle
      ? `${exhibition.data.title}: ${exhibition.data.subtitle}`
      : exhibition.data.title,
    href: `/exhibitions/${exhibition.id}`,
    role: 'Exhibition',
  })),
  ...projects.map((project) => ({
    year: project.data.year,
    title: project.data.title,
    href: `/projects/${project.id}`,
    role: project.data.role,
  })),
].sort((a, b) => Number(b.year) - Number(a.year));

const cvHref = site.cvUrl
  ? site.cvUrl
  : `mailto:${site.email}?subject=CV%20request`;
const cvExternal = Boolean(site.cvUrl);
---

<Base title="About" description={about.lede}>
  <header class="page-head wrap">
    <p class="eyebrow">{about.eyebrow}</p>
    <h1>{about.title}</h1>
    <p class="lede">{about.lede}</p>
  </header>

  <section class="section">
    <div class="wrap about-grid">
      <figure class="about-portrait">
        <img
          src={about.portrait}
          alt={about.portraitAlt}
          width="1000"
          height="1250"
        />
        <figcaption>
          <span>{about.portraitCaption}</span>
        </figcaption>
      </figure>

      <div class="prose about-copy">
        {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}

        <a
          class="btn"
          href={cvHref}
          target={cvExternal ? '_blank' : undefined}
          rel={cvExternal ? 'noopener noreferrer' : undefined}
        >
          {about.cvLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{about.workEyebrow}</p>
        <h2>{about.workHeading}</h2>
        <span class="note">{about.workNote}</span>
      </div>

      <ul class="exhibition-list">
        {work.map((item) => (
          <li>
            <time datetime={item.year}>{item.year}</time>
            <a href={item.href}>{item.title}</a>
            <span class="role">{item.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
