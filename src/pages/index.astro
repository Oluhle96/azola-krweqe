---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  byDate,
  byOrder,
  formatDate,
  site,
  type Post,
  type Project,
} from '../data/site';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(byOrder);
const featured = projects.filter((project: Project) => project.data.featured).slice(0, 3);
const writing = (await getCollection('writing')).sort(byDate).slice(0, 3) as Post[];
---

<Base>
  <section class="hero wrap">
    <div class="hero__grid">
      <div class="hero__title">
        <p class="eyebrow">Artist &amp; curator</p>
        <h1>
          <span class="line">The everyday</span>
          <span class="line">is the <em>archive.</em></span>
        </h1>
      </div>

      <div class="hero__aside">
        <p class="hero__lede">
          Exhibition-making, moving image and the records we keep. A practice
          built on the material of ordinary life.
        </p>
        <a class="btn" href="/home-affairs">
          Home Affairs — 2026 <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <figure class="hero__figure">
      <img
        src="/images/plate-01.svg"
        alt="Abstract exhibition graphic in cream, black and deep red"
        width="1600"
        height="700"
        fetchpriority="high"
      />
      <figcaption>
        <span>Home Affairs: The Everyday is the Archive</span>
        <span>Exhibition identity, 2026</span>
      </figcaption>
    </figure>
  </section>

  <section class="section">
    <div class="wrap intro-grid">
      <p class="eyebrow">Practice</p>
      <div class="intro-copy">
        <p class="intro-lede">
          Azola Krweqe is an artist and curator whose work moves between
          exhibition-making, moving image and research.
        </p>
        <p>
          Her practice begins with what is already there — family photographs,
          public records, the objects people keep — and asks how those materials
          shape the stories we tell about ourselves. Projects are built slowly,
          through conversation, and often take the form of a room to be entered
          rather than a statement to be read.
        </p>
        <p>
          Recent work brings artists and makers together around the archive as a
          living room rather than a locked cabinet: something entered,
          rearranged and returned to.
        </p>
        <a class="text-link" href="/about">
          Read the full biography <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">01 — Selected projects</p>
        <h2>Work that begins with what is already there.</h2>
        <a class="text-link" href="/projects">
          All projects <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="projects">
        {featured.map((project: Project, index: number) => (
          <ProjectCard project={project} index={index + 1} />
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Current exhibition</p>
      <div class="band__grid">
        <div>
          <h2>Home Affairs: The Everyday is the Archive</h2>
          <p class="band__lede">
            An exhibition about the records we keep, the stories they carry, and
            what it means to make a public life out of private material.
          </p>
          <a class="btn" href="/home-affairs">
            Enter the exhibition <span aria-hidden="true">↗</span>
          </a>
        </div>

        <dl class="band__details">
          <div>
            <dt>Dates</dt>
            <dd>December 2026 — January 2027</dd>
          </div>
          <div>
            <dt>Venue</dt>
            <dd>To be confirmed</dd>
          </div>
          <div>
            <dt>Access</dt>
            <dd>By appointment</dd>
          </div>
          <div>
            <dt>Curated by</dt>
            <dd>Azola Krweqe</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">02 — Writing</p>
        <h2>Notes on images, archives and display.</h2>
        <a class="text-link" href="/writing">
          All writing <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="writing-list">
        {writing.map((post: Post) => (
          <a
            class="writing-row"
            href={post.data.link}
            target="_blank"
            rel="noopener noreferrer"
          >
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <h3>{post.data.title}</h3>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
