---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import home from '../data/pages/home.json';
import {
  byDate,
  byOrder,
  formatDate,
  site,
  type Exhibition,
  type Post,
  type Project,
} from '../data/site';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(byOrder);
const featured = projects.filter((project: Project) => project.data.featured).slice(0, 3);
const writing = (await getCollection('writing')).sort(byDate).slice(0, 3) as Post[];
const exhibitions = (await getCollection('exhibitions')).sort(byOrder);
const currentExhibition = (exhibitions.find((exhibition: Exhibition) => exhibition.data.featured)
  ?? exhibitions[0]) as Exhibition | undefined;

const practiceParagraphs = home.practiceBody.split(/\n\s*\n/).filter(Boolean);
---

<Base transparentHeader>
  <section class="hero-hero">
    <img
      class="hero-hero__img"
      src={home.heroImage}
      alt={home.heroImageAlt}
      width="1600"
      height="900"
      fetchpriority="high"
    />
    <div class="hero-hero__scrim" aria-hidden="true"></div>

    <div class="wrap hero-hero__inner">
      <div class="hero-hero__title">
        <p class="eyebrow">{home.eyebrow}</p>
        <h1>
          <span class="line">{home.heroTitleLine1}</span>
          <span class="line">{home.heroTitleLine2Prefix} <em>{home.heroTitleAccent}</em></span>
        </h1>
      </div>

      <div class="hero-hero__foot">
        <p class="hero__lede">{home.heroLede}</p>
        {currentExhibition && (
          <a class="btn btn--light" href={`/exhibitions/${currentExhibition.id}`}>
            {currentExhibition.data.title} — {currentExhibition.data.year}{' '}
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>

    <figcaption class="wrap hero-hero__caption">
      <span>{home.heroCaptionLeft}</span>
      <span>{home.heroCaptionRight}</span>
    </figcaption>
  </section>

  <nav class="index-strip" aria-label="Sections">
    <div class="wrap index-strip__inner">
      <a href="/projects">
        <span class="num">01</span>
        <span class="name">{site.navProjects}</span>
        <span class="count">{projects.length} →</span>
      </a>
      <a href="/exhibitions">
        <span class="num">02</span>
        <span class="name">{site.navExhibitions}</span>
        <span class="count">{exhibitions.length} →</span>
      </a>
      <a href="/writing">
        <span class="num">03</span>
        <span class="name">{site.navWriting}</span>
        <span class="count">{writing.length} →</span>
      </a>
    </div>
  </nav>

  <section class="section">
    <div class="wrap intro-grid">
      <p class="eyebrow">{home.practiceEyebrow}</p>
      <div class="intro-copy">
        <p class="intro-lede">{home.practiceHeading}</p>
        {practiceParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a class="text-link" href="/about">
          {home.practiceLinkLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{home.projectsEyebrow}</p>
        <h2>{home.projectsHeading}</h2>
        <a class="text-link" href="/projects">
          {home.projectsLinkLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="projects">
        {featured.map((project: Project, index: number) => (
          <ProjectCard project={project} index={index + 1} />
        ))}
      </div>
    </div>
  </section>

  {currentExhibition && (
    <section class="band">
      <div class="wrap">
        <p class="eyebrow">{home.exhibitionEyebrow}</p>
        <div class="band__grid">
          <div>
            <h2>
              {currentExhibition.data.title}
              {currentExhibition.data.subtitle && (
                <span>: <em>{currentExhibition.data.subtitle}</em></span>
              )}
            </h2>
            <p class="band__lede">{currentExhibition.data.summary}</p>
            <a class="btn" href={`/exhibitions/${currentExhibition.id}`}>
              {home.exhibitionButtonLabel} <span aria-hidden="true">↗</span>
            </a>
          </div>

          <dl class="band__details">
            <div>
              <dt>Dates</dt>
              <dd>{currentExhibition.data.dates}</dd>
            </div>
            <div>
              <dt>Venue</dt>
              <dd>{currentExhibition.data.venue}</dd>
            </div>
            <div>
              <dt>Access</dt>
              <dd>{currentExhibition.data.access}</dd>
            </div>
            <div>
              <dt>Curated by</dt>
              <dd>{currentExhibition.data.curator}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{home.writingEyebrow}</p>
        <h2>{home.writingHeading}</h2>
        <a class="text-link" href="/writing">
          {home.writingLinkLabel} <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="writing-list">
        {writing.map((post: Post) => (
          <a
            class="writing-row"
            href={post.data.link}
            target="_blank"
            rel="noopener noreferrer"
          >
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <div>
              <h3>{post.data.title}</h3>
              <p class="muted" style="margin-top:.45rem;font-size:.95rem">
                {post.data.excerpt}
              </p>
            </div>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
