---
import Base from '../layouts/Base.astro';
import page from '../data/pages/writing.json';
import { byDate, formatDate, site, type Post } from '../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing')).sort(byDate) as Post[];
---

<Base title="Writing" description={page.lede}>
  <header class="page-head wrap">
    <p class="eyebrow">{page.eyebrow}</p>
    <h1>{page.title}</h1>
    <p class="lede">{page.lede}</p>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="writing-list">
        {posts.map((post: Post) => (
          <a
            class="writing-row"
            href={post.data.link}
            target="_blank"
            rel="noopener noreferrer"
          >
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <div>
              <h3>{post.data.title}</h3>
              <p class="muted" style="margin-top:.45rem;font-size:.95rem">
                {post.data.excerpt}
              </p>
            </div>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{page.subscribeEyebrow}</p>
      <h2>{page.subscribeHeading}</h2>
      <p class="lede">{page.subscribeLede}</p>
      <p style="margin-top:1.6rem">
        <a
          class="btn btn--solid"
          href={site.substack}
          target="_blank"
          rel="noopener noreferrer"
        >
          {page.subscribeLabel} <span aria-hidden="true">↗</span>
        </a>
      </p>
    </div>
  </section>
</Base>
