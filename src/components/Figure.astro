---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  ratio?: string;
}

const { src, alt, caption, ratio = '4 / 3' } = Astro.props;
---

<figure class="figure">
  <img
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
    style={`aspect-ratio:${ratio};object-fit:cover;`}
  />
  {caption && <figcaption><span>{caption}</span></figcaption>}
</figure>
